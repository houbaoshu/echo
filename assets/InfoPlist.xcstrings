    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo uses the microphone to dictate into the message field and for Live Voice. Dictation uses Apple’s on-device speech recognition; Live Voice uses Doubao speech recognition."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Echo 使用麦克风将讲话转写到输入框或进行语音通话。普通转写使用 Apple 本地识别；语音通话使用豆包识别。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo uses Apple’s on-device speech recognition to dictate into the message field. Audio isn’t sent to Apple’s servers."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Echo 使用 Apple 本地语音识别将讲话转写到输入框，音频不会发送至 Apple 云端。"
          }
        }
      }
    }
  },
  "version" : "1.0"
