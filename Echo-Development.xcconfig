// Native Xcode certificate signing, with the same optimization as Release.
// Select an installed Apple Development identity; missing certificates fail
// the build instead of falling back to an ad-hoc or self-signed identity.
// The development team selects the identity used by the app and its probes.
#include "Echo.xcconfig"

CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = 5953LL8ZRM
