// Single source of truth for Echo's build settings. project.pbxproj carries
// structure — targets, phases, file membership — and only the handful of
// settings that cannot be shared across targets, so changes stay reviewable.

SDKROOT = macosx
ARCHS = arm64
MACOSX_DEPLOYMENT_TARGET = 27.0
SWIFT_VERSION = 6
PRODUCT_NAME = $(TARGET_NAME)

// EchoRuntime and EchoAgentBridge are declared by the two module.modulemap files.
SWIFT_INCLUDE_PATHS = $(PROJECT_DIR)/runtime/include $(PROJECT_DIR)/agent-bridge/include
OTHER_LDFLAGS = $(PROJECT_DIR)/target/aarch64-apple-darwin/release/libecho_runtime.a $(PROJECT_DIR)/target/aarch64-apple-darwin/release/libecho_agent.a

// macos/Info.plist is complete and hand-maintained; Xcode must not synthesize
// keys on top of it. INFOPLIST_FILE itself is per target.
GENERATE_INFOPLIST_FILE = NO

// cargo writes to target/, which the script sandbox forbids.
ENABLE_USER_SCRIPT_SANDBOXING = NO

// The app has never been sandboxed and must not become so: it runs bash in a
// user-chosen project directory. The macOS App template turns these on.
ENABLE_APP_SANDBOX = NO
ENABLE_USER_SELECTED_FILES = NO
REGISTER_APP_GROUPS = NO

// Signing. Two modes, chosen with ECHO_SIGNING:
//   adhoc        Keychain-free validation build. Never resolves an identity.
//   development  Certificate-backed. scripts/signing-identity.sh resolves the
//                identity and writes the included file below.
// A locally bootstrapped certificate additionally signs through its dedicated
// Keychain with the designated requirement pinned to its fingerprint; an Apple
// certificate uses codesign's defaults. That split is the existing behaviour.
#include? "build/signing/Signing.xcconfig"

ECHO_SIGNING = adhoc
ECHO_IDENTITY_adhoc = -
ECHO_IDENTITY_development = $(ECHO_RESOLVED_IDENTITY)
ECHO_SIGN_FLAGS_adhoc_ =
ECHO_SIGN_FLAGS_adhoc_NO =
ECHO_SIGN_FLAGS_adhoc_YES =
ECHO_SIGN_FLAGS_development_ =
ECHO_SIGN_FLAGS_development_NO =
ECHO_SIGN_FLAGS_development_YES = --keychain $(ECHO_RESOLVED_KEYCHAIN) -r $(ECHO_RESOLVED_REQUIREMENT)

CODE_SIGNING_ALLOWED = YES
CODE_SIGNING_REQUIRED = YES
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = $(ECHO_IDENTITY_$(ECHO_SIGNING))
OTHER_CODE_SIGN_FLAGS = --timestamp=none $(ECHO_SIGN_FLAGS_$(ECHO_SIGNING)_$(ECHO_RESOLVED_PINNED))

// The bundle has never carried entitlements and has never used the hardened
// runtime; enabling either changes what the app may do and invalidates the
// Keychain grant that the pinned requirement exists to preserve.
ENABLE_HARDENED_RUNTIME = NO
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO

// Every test script already compiles these sources with -warnings-as-errors.
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES

// Deliberately NOT set, because swiftc does not apply them today and each one
// changes what the existing sources mean:
//   SWIFT_DEFAULT_ACTOR_ISOLATION (template default MainActor)
//   SWIFT_APPROACHABLE_CONCURRENCY
//   SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY
