// Single source of truth for Echo's build settings. project.pbxproj carries
// structure — targets, phases, file membership — and only the handful of
// settings that cannot be shared across targets, so changes stay reviewable.

SDKROOT = macosx
ARCHS = arm64
MACOSX_DEPLOYMENT_TARGET = 27.0
SWIFT_VERSION = 6
PRODUCT_NAME = $(TARGET_NAME)

// EchoRuntime and EchoExecBridge are declared by their module.modulemap files.
SWIFT_INCLUDE_PATHS = $(PROJECT_DIR)/runtime/include $(PROJECT_DIR)/exec-bridge/include
ECHO_CARGO_TARGET_DIR = $(OBJROOT)/EchoCargo
OTHER_LDFLAGS = "$(ECHO_CARGO_TARGET_DIR)/aarch64-apple-darwin/release/libecho_runtime.a" "$(ECHO_CARGO_TARGET_DIR)/aarch64-apple-darwin/release/libecho_exec.a"

// macos/Info.plist is complete and hand-maintained; Xcode must not synthesize
// keys on top of it. INFOPLIST_FILE itself is per target.
GENERATE_INFOPLIST_FILE = NO

// Cargo reads its cache and the adjacent path dependency outside Xcode outputs.
ENABLE_USER_SCRIPT_SANDBOXING = NO

// The app has never been sandboxed and must not become so: it runs zsh in a
// user-chosen project directory. The macOS App template turns these on.
ENABLE_APP_SANDBOX = NO
ENABLE_USER_SELECTED_FILES = NO
REGISTER_APP_GROUPS = NO

// Every configuration and target is signed by Xcode with the team's Apple
// Development certificate. The Keychain grants access to saved API keys by
// that signing identity, so a rebuild keeps the grant; an ad-hoc signature is
// tied to the code hash and would ask again after every build.
//
// The one exception is EchoUITests, set to Sign to Run Locally in the target:
// Xcode gives its runner a sandbox and application-identifier entitlement, and
// signing that with a certificate needs a provisioning profile, which would
// register an App ID and this Mac with Apple. The runner never reads Echo's
// keys, so a local signature costs nothing.
CODE_SIGNING_ALLOWED = YES
CODE_SIGNING_REQUIRED = YES
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = 5953LL8ZRM
OTHER_CODE_SIGN_FLAGS = --timestamp=none

// Preserve the app's existing runtime and entitlement behavior.
ENABLE_HARDENED_RUNTIME = NO
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO

// Keep production and native test targets on the same warning policy.
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES

// Do not enable these independently; they alter actor isolation and import behavior:
//   SWIFT_DEFAULT_ACTOR_ISOLATION (template default MainActor)
//   SWIFT_APPROACHABLE_CONCURRENCY
//   SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY

// Test plans own coverage collection; plain Run must not emit default.profraw.
ENABLE_CODE_COVERAGE = NO
